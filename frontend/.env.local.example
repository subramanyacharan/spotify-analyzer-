# =============================================================================
# Vercel / production — Project Settings → Environment Variables
# Repository: https://github.com/subramanyacharan/spotify-analyzer-
# Root Directory in Vercel: frontend
# =============================================================================

# --- Browser-safe (auth only) — safe to expose via NEXT_PUBLIC_ ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server-only (NEVER use NEXT_PUBLIC_ prefix) ---
SUPABASE_URL=https://your-project.supabase.co
# Service role key for dashboard data reads (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Legacy alias (optional) — must be service role, NOT the anon key
# SUPABASE_KEY=your-supabase-service-role-key

# =============================================================================
# Security checklist
# =============================================================================
# 1. Run supabase_schema.sql + supabase/auth_profiles.sql + supabase/rls_lockdown.sql
# 2. Never put service role key in NEXT_PUBLIC_* or client code
# 3. Supabase Auth → URL Configuration:
#      Site URL:     https://your-app.vercel.app
#      Redirect URL: https://your-app.vercel.app/auth/callback
# 4. Pipeline tables deny anon/authenticated access (RLS lockdown)

# =============================================================================
# Local dev
# =============================================================================
# Copy to .env.local. Without server keys, data falls back to ../data/outputs/*.json
