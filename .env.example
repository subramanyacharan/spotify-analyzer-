# Groq API (required for LLM analysis)
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API (required for embeddings — text-embedding-3-small)
OPENAI_API_KEY=sk_your-openai-api-key-here

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ChromaDB (optional)
CHROMA_PERSIST_DIR=./data/chroma_db

# Optional — Phase 5.3 notifications
SLACK_WEBHOOK_URL=
VERCEL_DASHBOARD_URL=https://your-app.vercel.app/overview
